{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getcryptodomains",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_API_URL": "https://auth.getcryptodomains.com"
  }
}
